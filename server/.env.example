PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional — leave unset to run without persistence (rooms/chat still work
# in real time, they just won't survive a server restart).
# Get a free Postgres instance from Render, or run one locally.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional — only used server-side (see server/src/routes/videos.js).
# Without this, video titles are still fetched via YouTube's public oEmbed
# endpoint, which needs no key at all.
YOUTUBE_API_KEY=your-youtube-data-api-key
